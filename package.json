{
  "name": "unity-asset-reference-mcp",
  "version": "0.3.3",
  "type": "module",
  "description": "Index a Unity project's assets into a reusable SQLite reference graph — impact analysis, unused-asset detection, dependency tracing, and an MCP server + web viewer. Unity-only.",
  "keywords": [
    "unity",
    "mcp",
    "model-context-protocol",
    "addressables",
    "asset",
    "dependency-graph",
    "unused-assets",
    "impact-analysis",
    "gamedev"
  ],
  "license": "MIT",
  "author": "JVinceW",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JVinceW/uasset-reference-memory-mcp.git"
  },
  "homepage": "https://github.com/JVinceW/uasset-reference-memory-mcp#readme",
  "bugs": {
    "url": "https://github.com/JVinceW/uasset-reference-memory-mcp/issues"
  },
  "bin": {
    "unity-asset-reference-mcp": "dist/mcp/server.js",
    "unity-asset-reference-mcp-index": "dist/cli/main.js",
    "unity-asset-reference-mcp-web": "dist/web/server.js"
  },
  "files": [
    "dist",
    "scripts/install.ps1",
    "scripts/install.sh",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "benchmark:indexer": "node scripts/benchmark-indexer.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.viewer.json --noEmit",
    "build:viewer": "vite build --config vite.viewer.config.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-public.mjs && npm run build:viewer",
    "web": "node dist/web/server.js",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "0.185.3",
    "@vitejs/plugin-react": "^4.7.0",
    "cytoscape": "^3.34.0",
    "sql.js": "^1.14.1",
    "typescript": "^5.7.0",
    "vite": "^5.4.21",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@react-three/fiber": "9.7.0",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.9",
    "better-sqlite3": "^12.11.1",
    "graphology": "^0.26.0",
    "graphology-layout-forceatlas2": "^0.10.1",
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sigma": "^3.0.3",
    "three": "0.185.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.21.5": true
  }
}
