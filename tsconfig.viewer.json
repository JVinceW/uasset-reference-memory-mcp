{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "rootDir": ".",
    "types": ["vite/client"]
  },
  "include": ["src/web/viewer/**/*.ts", "src/web/viewer/**/*.tsx", "vite.viewer.config.ts"],
  "exclude": ["dist", "node_modules"]
}
